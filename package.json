{
  "name": "agmp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:server": "node --experimental-strip-types apps/server/src/main.ts",
    "test:core": "node -e \"require('fs').rmSync('.tmp-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node scripts/ci/run-core-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:server": "tsc -p tsconfig.build.json",
    "gate": "node scripts/gates/check-architecture.mjs && node scripts/gates/check-no-go.mjs && node scripts/gates/check-ui-freeze.mjs && node scripts/gates/check-helper-ux.mjs && node scripts/common/check-naming.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.2"
  }
}
