{
  "version": "0.4.0",
  "status": "architecture-reset-candidate",
  "releaseLocked": true,
  "releaseLockReason": "Requires GitHub Runner validation for Rust Linux/Windows, Managed Java smoke, TypeScript/Electron build, and real product acceptance.",
  "architecture": {
    "agentPlatform": "typescript",
    "nativeRuntime": "rust",
    "ui": "vue",
    "desktopShell": "electron",
    "go": "retired",
    "wails": "retired"
  },
  "handoff": {
    "archive": "agmp-0.4.0.zip",
    "sha256": "agmp-0.4.0.sha256.txt",
    "forbiddenSuffixes": [
      "hotfix",
      "final",
      "fixed",
      "new",
      "v2"
    ],
    "workflow": [
      "extract",
      "AGMP-Sync.bat",
      "AGMP-GitHub.bat",
      "push",
      "verify-github-actions"
    ]
  },
  "runtime": {
    "modelBrain": "configured-vendor-model",
    "agentLoop": "typescript",
    "nativeRpc": "agmp.native.v1",
    "nativeSideEffects": "approval+single-use-rust-capability",
    "gameInstance": "shared-persistent-state"
  },
  "targets": {
    "web": {
      "status": "migration",
      "controlPlane": "typescript"
    },
    "windowsElectron": {
      "status": "migration",
      "nativeRuntime": "rust"
    },
    "linuxHeadless": {
      "status": "migration",
      "nativeRuntime": "rust"
    },
    "macOSDesktop": {
      "status": "planned"
    }
  },
  "validation": {
    "ciGreenRequired": true,
    "ciGreenAloneIsReleaseApproval": false,
    "requiredProductEvidence": [
      "real-model-generation",
      "real-tool-call-observation-loop",
      "minecraft-start-ready-ping",
      "shared-game-instance"
    ]
  }
}
